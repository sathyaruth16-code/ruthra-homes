{
  "folders": [
    {
      "path": ".",
      "name": "Ruther Homes - Root"
    },
    {
      "path": "backend",
      "name": "Backend - Node.js/Express"
    },
    {
      "path": "frontend",
      "name": "Frontend - Web App"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.exclude": {
      "**/node_modules": true,
      "**/.DS_Store": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "package-lock.json": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug Backend",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder:Backend - Node.js/Express}/server.js",
        "restart": true,
        "console": "integratedTerminal",
        "env": {
          "NODE_ENV": "development"
        }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "esbenp.prettier-vscode",
      "ms-vscode.vscode-typescript-next",
      "dbaeumer.vscode-eslint",
      "ms-mssql.sql",
      "ms-python.python"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "npm: install (backend)",
        "type": "shell",
        "command": "npm",
        "args": ["install"],
        "cwd": "${workspaceFolder:Backend - Node.js/Express}",
        "problemMatcher": [],
        "group": {
          "kind": "build",
          "isDefault": false
        }
      },
      {
        "label": "npm: start (backend)",
        "type": "shell",
        "command": "npm",
        "args": ["start"],
        "cwd": "${workspaceFolder:Backend - Node.js/Express}",
        "isBackground": true,
        "problemMatcher": {
          "pattern": {
            "regexp": "^.*$",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^Server running",
            "endsPattern": "^Server running"
          }
        },
        "group": {
          "kind": "test",
          "isDefault": false
        }
      }
    ]
  }
}
